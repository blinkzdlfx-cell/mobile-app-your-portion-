# Supabase config
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_admin_password

# JWT secret
JWT_SECRET=generate_a_secure_random_string

# Notifications (optional — in-app works without these)
# Email:
# SMTP_URL=https://your-email-relay.example.com/send
# NOTIFICATION_EMAIL_FROM=Your Portion <noreply@example.com>
#
# Push (FCM HTTP v1 — recommended):
# Paste the Firebase service account JSON as a single line.
# Firebase console → Project settings → Service accounts → Generate new private key.
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----..."}
#
# Legacy push (deprecated by Google, avoid):
# FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
